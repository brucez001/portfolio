# EmailJS credentials for the contact form (src/app/components/contact-actions.ts).
# Server-only: read inside a Server Action, never shipped to the browser.
# Leave blank locally and the form returns a "temporarily unavailable" message.
# Production values live in the Vercel project settings.
EMAIL_SERVICE_ID=
EMAIL_TEMPLATE_ID=
EMAIL_PUBLIC_KEY=
EMAIL_PRIVATE_KEY=
